variant: flatcar
version: 1.1.0

# Provision the tools sysext and keep it current with systemd-sysupdate.
# Transpile with butane and feed the result to Ignition:
#   butane --strict tools-sysext.bu > tools-sysext.ign

storage:
  files:
    # Seed image from the unversioned asset, which tracks the latest release.
    # Saved as version 0 so sysupdate prunes it as the oldest instance.
    - path: /opt/extensions/tools/tools-0-x86-64.raw
      mode: 0644
      contents:
        source: https://github.com/tesserac-ai/flatcar-packages/releases/download/tools/tools-x86-64.raw

    - path: /etc/sysupdate.tools.d/tools.transfer
      contents:
        source: https://github.com/tesserac-ai/flatcar-packages/releases/download/tools/tools.transfer

    # Make the default (componentless) sysupdate run a no-op.
    - path: /etc/sysupdate.d/noop.transfer
      contents:
        source: https://github.com/tesserac-ai/flatcar-packages/releases/download/tools/noop.transfer

  directories:
    # Also made by the sysext's tmpfiles.d; this way boot order doesn't matter.
    - path: /etc/emacs/site-start.d

  links:
    - path: /etc/extensions/tools.raw
      target: /opt/extensions/tools/tools-0-x86-64.raw
      hard: false

systemd:
  units:
    # Enabled by default on stable, beta and alpha, but not on LTS.
    - name: systemd-sysupdate.timer
      enabled: true

    # Update the tools component on each sysupdate run. Flag a reboot only when
    # tools.raw moves to different bytes, not when the seed's bytes get a
    # versioned name.
    - name: systemd-sysupdate.service
      dropins:
        - name: tools.conf
          contents: |
            [Service]
            ExecStartPre=/usr/bin/sh -c 'readlink -f /etc/extensions/tools.raw > /run/tools-old'
            ExecStartPre=/usr/lib/systemd/systemd-sysupdate -C tools update
            ExecStartPost=/usr/bin/sh -c 'cmp -s "$$(cat /run/tools-old)" /etc/extensions/tools.raw || touch /run/reboot-required'
